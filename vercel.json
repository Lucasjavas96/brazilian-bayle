{
  "framework": null,
  "installCommand": "",
  "buildCommand": "node _local/build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/temperatura",
      "destination": "/intermediacao",
      "permanent": true
    },
    {
      "source": "/djpedia",
      "destination": "/djindex",
      "permanent": true
    },
    {
      "source": "/djpedia/:slug",
      "destination": "/djindex/:slug",
      "permanent": true
    },
    {
      "source": "/criticos",
      "destination": "/spotted",
      "permanent": true
    },
    {
      "source": "/criticos/:path*",
      "destination": "/spotted",
      "permanent": true
    },
    {
      "source": "/galeria",
      "destination": "/spotted",
      "permanent": true
    },
    {
      "source": "/sacola",
      "has": [
        {
          "type": "query",
          "key": "peca",
          "value": "01-work-it"
        }
      ],
      "destination": "/loja/camiseta-work-it-harder",
      "permanent": false
    },
    {
      "source": "/sacola",
      "has": [
        {
          "type": "query",
          "key": "peca",
          "value": "02-make-djs-mix-again"
        }
      ],
      "destination": "/loja/camiseta-make-djs-mix-again",
      "permanent": false
    },
    {
      "source": "/sacola",
      "has": [
        {
          "type": "query",
          "key": "peca",
          "value": "03-vintage-culture"
        }
      ],
      "destination": "/loja/camiseta-vintage-culture",
      "permanent": false
    },
    {
      "source": "/sacola",
      "has": [
        {
          "type": "query",
          "key": "peca",
          "value": "04-546-im-yours"
        }
      ],
      "destination": "/loja/camiseta-546-im-yours",
      "permanent": false
    },
    {
      "source": "/sacola",
      "has": [
        {
          "type": "query",
          "key": "peca",
          "value": "05-que-festa-boa"
        }
      ],
      "destination": "/loja/camiseta-que-festa-boa",
      "permanent": false
    },
    {
      "source": "/sacola",
      "has": [
        {
          "type": "query",
          "key": "peca",
          "value": "06-techno-addict"
        }
      ],
      "destination": "/loja/camiseta-techno-addict",
      "permanent": false
    },
    {
      "source": "/sacola",
      "has": [
        {
          "type": "query",
          "key": "peca",
          "value": "07-keep-following"
        }
      ],
      "destination": "/loja/camiseta-keep-following-the-bayle",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-OGq9iyZ+l9PgUtU+8amu9vwcxeZk2EKbT+0VHwahr68=' https://*.clarity.ms https://sdk.mercadopago.com https://http2.mlstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://*.clarity.ms https://c.bing.com https://secure-fields.mercadopago.com https://api.mercadopago.com https://api-static.mercadopago.com https://api.mercadolibre.com https://sdk.mercadopago.com https://http2.mlstatic.com https://viacep.com.br https://bereyocdqacudfvazdpa.supabase.co wss://bereyocdqacudfvazdpa.supabase.co; font-src 'self'; frame-src https://www.google.com https://secure-fields.mercadopago.com https://www.mercadopago.com.br; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}

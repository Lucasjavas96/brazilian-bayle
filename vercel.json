{
  "framework": null,
  "installCommand": "",
  "buildCommand": "node _local/build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/criticos",
      "destination": "/spotted",
      "permanent": true
    },
    {
      "source": "/criticos/:path*",
      "destination": "/spotted",
      "permanent": true
    },
    {
      "source": "/galeria",
      "destination": "/spotted",
      "permanent": true
    }
  ]
}

Options -Indexes -MultiViews
DirectoryIndex index.html
RewriteEngine On
RewriteRule ^(?:supabase|scripts|tests|src|_local|\.git)(?:/|$) - [F,L]
RewriteCond %{HTTP_HOST} ^www\.brazilianbayle\.com\.br$ [NC]
RewriteRule ^ https://brazilianbayle.com.br%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://brazilianbayle.com.br%{REQUEST_URI} [R=301,L]
RewriteRule ^temperatura/?$ /intermediacao [R=301,L]
RewriteRule ^djpedia/?$ /djindex [R=301,L]
RewriteRule ^djpedia/(.+)$ /djindex/$1 [R=301,L]
RewriteRule ^loja/camiseta-(?:work-it-harder|vintage-culture|techno-addict|thay3|thay9)/?$ /loja [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
<FilesMatch "\.(html|css|js)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://sdk.mercadopago.com https://http2.mlstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://secure-fields.mercadopago.com https://api.mercadopago.com https://api-static.mercadopago.com https://api.mercadolibre.com https://sdk.mercadopago.com https://http2.mlstatic.com https://viacep.com.br https://bereyocdqacudfvazdpa.supabase.co wss://bereyocdqacudfvazdpa.supabase.co; font-src 'self'; frame-src https://www.google.com https://secure-fields.mercadopago.com https://www.mercadopago.com.br; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
</IfModule>
